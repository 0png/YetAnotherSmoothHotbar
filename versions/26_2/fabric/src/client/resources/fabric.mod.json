{
  "schemaVersion": 1,
  "id": "yash",
  "version": "${version}",
  "name": "YASH",
  "description": "A lightweight and customizable animated hotbar selector mod.",
  "authors": [
    "YASH Contributors"
  ],
  "contact": {
    "homepage": "https://github.com/0png/YetAnotherSmoothHotbar",
    "sources": "https://github.com/0png/YetAnotherSmoothHotbar",
    "issues": "https://github.com/0png/YetAnotherSmoothHotbar/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.yash.fabric.v26_2.YashFabricClient"
    ],
    "modmenu": [
      "dev.yash.fabric.v26_2.YashModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "yash.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.156.0"
  },
  "suggests": {
    "modmenu": ">=20.0.1"
  },
  "custom": {
    "yash:assets_license": "All Rights Reserved; see ASSETS_LICENSE.md"
  }
}
